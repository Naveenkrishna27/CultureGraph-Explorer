# Copy this file to .env (same folder) and fill it in. NEVER commit .env.
# One .env here serves probe.py and the backend.

# --- Qloo (required) ---
QLOO_API_KEY=your_qloo_key_here
# Default is the hackathon server. Hackathon keys only work against this URL.
# QLOO_API_URL=https://hackathon.api.qloo.com

# --- Language model (optional) ---
# Without it the agent still works, using its scoring rules and plain templates.
# LLM_PROVIDER: none | anthropic | openai | gemini
LLM_PROVIDER=none
LLM_API_KEY=
# Use a current model name from your provider's docs, for example:
#   anthropic: claude-sonnet-5-5     openai: gpt-4o-mini     gemini: gemini-2.0-flash
LLM_MODEL=

# --- Limits (defaults shown) ---
# MAX_QLOO_CALLS=12
# MAX_LLM_CALLS=8
# RATE_LIMIT_PER_HOUR=20
# DAILY_JOURNEY_CAP=300

# --- Deployment ---
# ALLOWED_ORIGINS=http://localhost:5173
# TRUST_PROXY=true     # set when behind a host's proxy so rate limits see real visitor IPs
